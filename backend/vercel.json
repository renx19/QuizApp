{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "json/ClinicalChemistry.json",
          "json/ClinicalMicroscopy.json",
          "json/IBSS.json",
          "json/Hematology.json",
          "json/MedtechLaws.json",
          "json/Microbiology.json"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "index.js" }
  ]
}
